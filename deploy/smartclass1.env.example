# 应用配置
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 数据库配置 (请修改为实际的数据库连接信息)
DATABASE_URL=mysql+pymysql://username:password@host:port/database?charset=utf8mb4

# LLM 服务配置
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# LLM 备用配置 (可选)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_API_KEY=

# 阿里云语音识别配置
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_APP_KEY=your-aliyun-app-key

# 阿里云 OSS 配置 (可选)
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_DOMAIN=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com
OSS_VIDEO_PREFIX=video_chunks/
OSS_SNAPSHOT_PREFIX=snapshots/

# Agora RTC 配置
AGORA_APP_ID=d3144900be6843d8a8c14271f1da8cdb
AGORA_AUTH_MODE=appid

# 研究模块配置 (可选)
RESEARCH_DEPLOYMENT_PROFILE=standard
RESEARCH_MODULES_ENABLED=false
RESEARCH_RUNTIME_MODE=documented_only
RESEARCH_MODEL_ROOT=/opt/smartclass1/storage/research_models
RESEARCH_GALLERY_ROOT=/opt/smartclass1/storage/research_gallery
RESEARCH_CACHE_ROOT=/opt/smartclass1/storage/research_runtime_cache
RESEARCH_MODEL_SOURCE=manual_local
RESEARCH_AUTO_DOWNLOAD_MODELS=false
RESEARCH_HF_TOKEN=
RESEARCH_ENHANCED_PYTHON=/opt/smartclass1/venv/bin/python
