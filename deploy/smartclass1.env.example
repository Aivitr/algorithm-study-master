# 智能协作学习系统 — 生产环境变量模板
# 安装位置：/etc/smartclass1/smartclass1.env  （权限 600，owner root）
# 由 systemd EnvironmentFile= 注入；config.py 用 os.environ.setdefault 读取，
# 因此这里的取值优先于项目目录下的 .env。

# 应用配置
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 注意：APP_HOST/APP_PORT 目前仅在 config.py 中被解析，
# server.py 的 __main__ 仍是硬编码 uvicorn.run(app, host="0.0.0.0", port=8000)。

# ===== 数据库 =====
# 本项目用的是 SQL Server (MSSQL / T-SQL)，不是 MySQL。
# 线上为阿里云 RDS SQL Server，默认端口 3433（不是 1433）。
# 格式：mssql+pymssql://<user>:<password>@<host>:<port>/<db>?charset=utf8
#
# ⚠️ charset 必须保持 utf8。pymssql/FreeTDS 对 varchar 列不做代码页转换：
#      charset=utf8  → 写入正确
#      charset=cp936 → 写入会被二次编码，中文**不可逆损坏**（变成 ?）
#    配合 database.py 中中文列使用 Unicode/NVARCHAR 类型，读写才能全对。
#
# ⚠️ 建库时排序规则必须指定中文，否则 varchar 存不了中文：
#      CREATE DATABASE <db> COLLATE Chinese_PRC_CI_AS
DATABASE_URL=mssql+pymssql://username:password@host:3433/database?charset=utf8

# 旧版独立诊断脚本（init_db.py / check_*.py）才需要下面这组；应用本身只读 DATABASE_URL。
# 保留时务必与 DATABASE_URL 指向同一个库，否则会出现"能登录但读不到数据"这类不一致。
#DB_HOST=
#DB_PORT=3433
#DB_USER=
#DB_PASSWORD=
#DB_NAME=

# LLM 服务配置
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# LLM 备用配置 (可选)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_API_KEY=

# 阿里云语音识别配置 (实时字幕必需；不配则课堂内无转写)
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_APP_KEY=your-aliyun-app-key

# 阿里云 OSS 配置 (可选)
# ⚠️ 实际只有下面两行会被读取（oss_config.py 读 OSS_ACCESS_KEY_ID/SECRET）。
#    bucket / endpoint / domain / prefix 在 oss_config.py 里是**硬编码**的
#    （collaborative-learning-videos / oss-cn-hangzhou.aliyuncs.com），
#    写在这里不会生效——要换 bucket 或地域必须改 oss_config.py。
# ⚠️ 未配置 OSS 时不会自动"降级为本地存储"：上传线程会报
#    "[ERROR] 上传到OSS失败"，只是库里该行仍保留本地 /storage/... 路径。
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
# 以下四项当前不生效，保留仅为与 config.py 的 settings 字段对照
#OSS_BUCKET_NAME=your-bucket-name
#OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
#OSS_DOMAIN=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com
#OSS_VIDEO_PREFIX=video_chunks/
#OSS_SNAPSHOT_PREFIX=snapshots/

# Agora RTC 配置
# appid 模式下服务端不需要 token；server.py 另有内置兜底 App ID。
AGORA_APP_ID=
AGORA_AUTH_MODE=appid

# 研究模块配置 (标准版关闭；开启需另行下载 6 个模型权重)
RESEARCH_DEPLOYMENT_PROFILE=standard
RESEARCH_MODULES_ENABLED=false
RESEARCH_RUNTIME_MODE=documented_only
RESEARCH_MODEL_ROOT=/opt/smartclass1/storage/research_models
RESEARCH_GALLERY_ROOT=/opt/smartclass1/storage/research_gallery
RESEARCH_CACHE_ROOT=/opt/smartclass1/storage/research_runtime_cache
RESEARCH_MODEL_SOURCE=manual_local
RESEARCH_AUTO_DOWNLOAD_MODELS=false
RESEARCH_HF_TOKEN=
RESEARCH_ENHANCED_PYTHON=/opt/smartclass1/venv/bin/python
