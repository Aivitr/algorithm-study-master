# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# ===== Agora RTC（App ID 模式，App ID 非机密；真正机密的是未配置的 App Certificate）=====
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_AUTH_MODE=appid

# ===== 阿里云 NLS 语音识别 =====
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_APP_KEY=

# ===== 阿里云 OSS（与 NLS 同一对 AccessKey）=====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== 阿里云 facebody 表情识别（独立的一对 AccessKey）=====
ALIYUN_FACE_ACCESS_KEY_ID=
ALIYUN_FACE_ACCESS_KEY_SECRET=

# ===== LLM（DeepSeek）=====
LLM_API_KEY=

# ===== 数据库 =====
# 本项目用 SQL Server (MSSQL / T-SQL)，不是 MySQL。线上为阿里云 RDS SQL Server，端口 3433。
# 格式: mssql+pymssql://<user>:<password>@<host>:3433/<db>?charset=utf8
#
# 留空则回退到本地 SQLite（sqlite:///./storage/app.db），可零依赖跑通基本流程；
# 但生产必须用 MSSQL——代码里有 IDENTITY/GETDATE/TOP/NVARCHAR 等 T-SQL 专有写法。
#
# charset 必须保持 utf8：pymssql/FreeTDS 对 varchar 不做代码页转换，
# charset=cp936 会让中文在**写入时**被二次编码、不可逆损坏。
DATABASE_URL=

# 旧版独立诊断脚本（init_db.py / check_*.py）才需要下面这组；应用本身只读 DATABASE_URL。
#DB_HOST=
#DB_PORT=3433
#DB_USER=
#DB_PASSWORD=
#DB_NAME=

# ===== HuggingFace（研究增强模块，可选）=====
HF_TOKEN=
