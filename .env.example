# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# ===== Agora RTC（App ID 模式，App ID 非机密；真正机密的是未配置的 App Certificate）=====
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_AUTH_MODE=appid

# ===== 阿里云 NLS 语音识别 =====
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_APP_KEY=

# ===== 阿里云 OSS（与 NLS 同一对 AccessKey）=====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== 阿里云 facebody 表情识别（独立的一对 AccessKey）=====
ALIYUN_FACE_ACCESS_KEY_ID=
ALIYUN_FACE_ACCESS_KEY_SECRET=

# ===== LLM（DeepSeek）=====
LLM_API_KEY=

# ===== 数据库（阿里云 RDS SQL Server / MSSQL）=====
# database.py 读 DATABASE_URL（留空则回退到本地 SQLite）；server.py 及 check_*.py 直连脚本读 DB_*
# 格式: mssql+pymssql://<user>:<password>@<host>:3433/<db>?charset=utf8
DATABASE_URL=
DB_HOST=
DB_PORT=3433
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== HuggingFace（研究增强模块，可选）=====
HF_TOKEN=
