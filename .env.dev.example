# ===== 开发 / 比赛环境：直连远程数据库 =====
#
# 用法：  cp .env.dev.example .env.dev
# 然后把下面 6 个值填成远程库的连接信息。.env.dev 已被 gitignore，不会入库。
#
# 为什么是 6 个键：ORM 读 DATABASE_URL，而 /api/register 与 /api/login 直接
# pymssql.connect(DB_HOST, DB_PORT, ...)，不读 DATABASE_URL。只填 DATABASE_URL
# 会导致注册/登录连不上。
#
# ⚠️ DB_AUTO_MIGRATE=0：禁止 app 在导入期对远程库执行 ALTER TABLE。
#    需要补列时，用显式迁移脚本，不要在开发启动时顺手改远程库。

DB_AUTO_MIGRATE=0

DB_HOST=<远程数据库主机名>
DB_PORT=<端口；阿里云 RDS SQL Server 常见为 3433>
DB_USER=<用户名>
DB_PASSWORD=<口令>
DB_NAME=<库名>

DATABASE_URL=mssql+pymssql://<用户名>:<口令>@<主机>:<端口>/<库名>?charset=utf8

# ---------------------------------------------------------------------------
# 可选：本地 MSSQL（默认不启动）
#
#   docker compose --profile local-db up
#
# 用本地库时，把上面的 DB_HOST 改成 db、DB_PORT 改成 1433，并补一个
# MSSQL_SA_PASSWORD（db 容器初始化 sa 用它，且要与 DB_PASSWORD 一致）：
#
# MSSQL_SA_PASSWORD=<本地 sa 口令>
# DB_HOST=db
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=<本地 sa 口令>
# DB_NAME=cscl_db
# DATABASE_URL=mssql+pymssql://sa:<本地 sa 口令>@db:1433/cscl_db?charset=utf8
# ---------------------------------------------------------------------------
